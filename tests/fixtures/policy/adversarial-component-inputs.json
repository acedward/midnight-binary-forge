    { "name": "build-without-toolchain-digest", "base": "valid-software.json", "delete": ["source/toolchainDigest"] },
    { "name": "build-without-explicit-flags", "base": "valid-software.json", "delete": ["source/buildFlags"] },
    { "name": "build-with-mismatched-toolchain-digest", "base": "valid-software.json", "set": { "source/toolchainDigest": "9999999999999999999999999999999999999999999999999999999999999999" } },
    { "name": "build-with-mutable-toolchain-tag", "base": "valid-software.json", "set": { "source/toolchain": "docker.io/library/python:3.12-bookworm" } },
    {
