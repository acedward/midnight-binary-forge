{
  "schemaVersion": "adversarial-component-cases-v1",
  "cases": [
    {
      "name": "audit-build-without-immutable-inputs",
      "base": "valid-software.json",
      "delete": ["source/lockedDependencies", "source/toolchain", "source/toolchainDigest", "source/buildFlags"]
    },
    { "name": "build-without-locked-dependencies", "base": "valid-software.json", "delete": ["source/lockedDependencies"] },
