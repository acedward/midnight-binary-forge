    { "name": "mirror-object-without-url", "base": "valid-srs-k1.json", "delete": ["source/object/url"] },
    { "name": "mirror-object-without-size", "base": "valid-srs-k1.json", "delete": ["source/object/size"] },
    { "name": "mirror-object-without-sha256", "base": "valid-srs-k1.json", "delete": ["source/object/sha256"] },
    {
