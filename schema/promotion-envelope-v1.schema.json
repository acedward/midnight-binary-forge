{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acedward/midnight-binary-forge/schema/promotion-envelope-v1.schema.json",
  "title": "Forge-to-warehouse promotion envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canonicalization", "claims", "claimsDigest", "signatures"],
  "properties": {
    "schemaVersion": { "const": "promotion-envelope-v1" },
    "canonicalization": { "const": "forge-canonical-json-v1" },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "staging",
        "candidate",
        "buildSet",
        "assets",
        "assetListSha256",
        "payloadCount",
        "evidenceCount",
        "totalAssetCount"
      ],
      "properties": {
        "issuer": { "$ref": "#/$defs/issuer" },
        "staging": { "$ref": "#/$defs/staging" },
        "candidate": { "$ref": "#/$defs/candidate" },
        "buildSet": { "$ref": "#/$defs/buildSet" },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/asset" }
        },
        "assetListSha256": { "$ref": "#/$defs/sha256" },
        "payloadCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "evidenceCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "totalAssetCount": { "type": "integer", "minimum": 2, "maximum": 1000 }
      }
    },
    "claimsDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/signature" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "repositoryId", "repositoryNodeId", "workflowPath", "workflowSha", "ref", "commitSha"],
      "properties": {
        "repository": { "const": "acedward/midnight-binary-forge" },
        "repositoryId": { "const": 1349127482 },
        "repositoryNodeId": { "const": "R_kgDOUGoNOg" },
        "workflowPath": { "const": ".github/workflows/candidate.yml" },
        "workflowSha": { "$ref": "#/$defs/gitSha" },
        "ref": { "type": "string", "pattern": "^refs/(heads/main|tags/forge-[A-Za-z0-9._-]+)$" },
        "commitSha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "runId", "runAttempt", "artifactId", "artifactName", "archiveSha256", "expiresAt"],
      "properties": {
        "provider": { "const": "github-actions-artifact" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactName": { "type": "string", "pattern": "^verified-candidate-[a-z0-9][a-z0-9._-]+-[0-9a-f]{64}$" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "releaseId", "releaseNodeId", "releaseUrl", "immutable", "publishedAt"],
      "properties": {
        "tag": { "type": "string", "pattern": "^forge-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$" },
        "releaseId": { "type": "integer", "minimum": 1 },
        "releaseNodeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "releaseUrl": { "type": "string", "pattern": "^https://github\\.com/acedward/midnight-binary-forge/releases/tag/forge-" },
        "immutable": { "const": true },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "buildSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manifestName", "manifestSha256", "checksumsName", "checksumsSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "manifestName": { "type": "string", "pattern": "^source-manifest-[a-z0-9][a-z0-9._-]+\\.json$" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "checksumsName": { "type": "string", "pattern": "^sha256sums-[a-z0-9][a-z0-9._-]+\\.txt$" },
        "checksumsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "size", "sha256", "mediaType"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
        "role": {
          "enum": [
            "payload",
            "source-manifest",
            "checksums",
            "license",
            "notice",
            "sbom-spdx",
            "sbom-cyclonedx",
            "lineage-manifest",
            "member-manifest",
            "provenance",
            "attestation",
            "build-log-digest"
          ]
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[A-Za-z0-9.+-]+$" },
        "artifactKind": { "enum": ["software", "proof-data"] },
        "componentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "payload" } }, "required": ["role"] },
          "then": { "required": ["artifactKind", "componentId"] },
          "else": { "not": { "anyOf": [{ "required": ["artifactKind"] }, { "required": ["componentId"] }] } }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predicateType", "bundleName", "bundleSha256", "subjectDigest", "issuer", "identity"],
      "properties": {
        "kind": { "const": "github-artifact-attestation" },
        "predicateType": { "const": "https://github.com/acedward/midnight-binary-forge/predicates/promotion-envelope/v1" },
        "bundleName": { "type": "string", "pattern": "^attestation-[A-Za-z0-9._-]+\\.sigstore\\.json$" },
        "bundleSha256": { "$ref": "#/$defs/sha256" },
        "subjectDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "issuer": { "const": "https://token.actions.githubusercontent.com" },
        "identity": { "const": "https://github.com/acedward/midnight-binary-forge/.github/workflows/candidate.yml@refs/heads/main" }
      }
    }
  }
}
