{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acedward/midnight-binary-forge/schema/promotion-envelope-v1.schema.json",
  "title": "Forge-to-warehouse promotion envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canonicalization", "claims", "claimsDigest", "attestation"],
  "properties": {
    "schemaVersion": { "const": "promotion-envelope-v1" },
    "canonicalization": { "const": "forge-canonical-json-v1" },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer", "staging", "candidateDraft", "buildSet", "transport",
        "contentAssets", "contentAssetListSha256", "completeAssetNames",
        "completeAssetNameListSha256", "payloadCount", "contentEvidenceCount",
        "transportAssetCount", "totalAssetCount"
      ],
      "properties": {
        "issuer": { "$ref": "#/$defs/issuer" },
        "staging": { "$ref": "#/$defs/staging" },
        "candidateDraft": { "$ref": "#/$defs/candidateDraft" },
        "buildSet": { "$ref": "#/$defs/buildSet" },
        "transport": { "$ref": "#/$defs/transport" },
        "contentAssets": { "type": "array", "minItems": 1, "maxItems": 998, "items": { "$ref": "#/$defs/contentAsset" } },
        "contentAssetListSha256": { "$ref": "#/$defs/sha256" },
        "completeAssetNames": { "type": "array", "minItems": 3, "maxItems": 1000, "items": { "$ref": "#/$defs/safeName" } },
        "completeAssetNameListSha256": { "$ref": "#/$defs/sha256" },
        "payloadCount": { "type": "integer", "minimum": 1, "maximum": 998 },
        "contentEvidenceCount": { "type": "integer", "minimum": 1, "maximum": 997 },
        "transportAssetCount": { "const": 2 },
        "totalAssetCount": { "type": "integer", "minimum": 3, "maximum": 1000 }
      }
    },
    "claimsDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predicateType", "bundleName", "bundleSha256", "subjectDigest", "issuer", "identity"],
      "properties": {
        "kind": { "const": "github-artifact-attestation" },
        "predicateType": { "const": "https://github.com/acedward/midnight-binary-forge/predicates/promotion-envelope/v1" },
        "bundleName": { "$ref": "#/$defs/attestationName" },
        "bundleSha256": { "$ref": "#/$defs/sha256" },
        "subjectDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "issuer": { "const": "https://token.actions.githubusercontent.com" },
        "identity": { "const": "https://github.com/acedward/midnight-binary-forge/.github/workflows/candidate.yml@refs/heads/main" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "safeName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
    "envelopeName": { "type": "string", "pattern": "^promotion-envelope-[a-z0-9][a-z0-9._-]{2,127}\\.json$" },
    "attestationName": { "type": "string", "pattern": "^attestation-[a-z0-9][a-z0-9._-]{2,127}\\.sigstore\\.json$" },
    "issuer": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "repositoryId", "repositoryNodeId", "workflowPath", "workflowSha", "ref", "commitSha"],
      "properties": {
        "repository": { "const": "acedward/midnight-binary-forge" },
        "repositoryId": { "const": 1349127482 },
        "repositoryNodeId": { "const": "R_kgDOUGoNOg" },
        "workflowPath": { "const": ".github/workflows/candidate.yml" },
        "workflowSha": { "$ref": "#/$defs/gitSha" },
        "ref": { "const": "refs/heads/main" },
        "commitSha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "staging": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "runId", "runAttempt", "artifactId", "artifactName", "archiveSha256", "expiresAt"],
      "properties": {
        "provider": { "const": "github-actions-artifact" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactName": { "type": "string", "pattern": "^verified-content-[a-z0-9][a-z0-9._-]{2,127}-[0-9a-f]{64}$" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "expiresAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    },
    "candidateDraft": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "repositoryId", "repositoryNodeId", "tag", "targetCommitish", "releaseId", "releaseNodeId", "releaseUrl", "liveImmutableVerificationRequired"],
      "properties": {
        "repository": { "const": "acedward/midnight-binary-forge" },
        "repositoryId": { "const": 1349127482 },
        "repositoryNodeId": { "const": "R_kgDOUGoNOg" },
        "tag": { "type": "string", "pattern": "^forge-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$" },
        "targetCommitish": { "$ref": "#/$defs/gitSha" },
        "releaseId": { "type": "integer", "minimum": 1 },
        "releaseNodeId": { "type": "string", "pattern": "^RE_[A-Za-z0-9_-]+$" },
        "releaseUrl": { "type": "string", "pattern": "^https://github\\.com/acedward/midnight-binary-forge/releases/tag/forge-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$" },
        "liveImmutableVerificationRequired": { "const": true }
      }
    },
    "buildSet": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "manifestName", "manifestSha256", "checksumsName", "checksumsSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "manifestName": { "type": "string", "pattern": "^source-manifest-[a-z0-9][a-z0-9._-]{2,127}\\.json$" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "checksumsName": { "type": "string", "pattern": "^sha256sums-[a-z0-9][a-z0-9._-]{2,127}\\.txt$" },
        "checksumsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["envelopeName", "attestationBundleName"],
      "properties": {
        "envelopeName": { "$ref": "#/$defs/envelopeName" },
        "attestationBundleName": { "$ref": "#/$defs/attestationName" }
      }
    },
    "contentAsset": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "role", "size", "sha256", "mediaType"],
      "properties": {
        "name": { "$ref": "#/$defs/safeName" },
        "role": { "enum": ["payload", "source-manifest", "checksums", "license", "notice", "sbom-spdx", "sbom-cyclonedx", "lineage-manifest", "member-manifest", "provenance", "build-log-digest"] },
        "size": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$" },
        "artifactKind": { "enum": ["software", "proof-data"] },
        "componentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" }
      },
      "allOf": [
        { "if": { "properties": { "role": { "const": "payload" } }, "required": ["role"] }, "then": { "required": ["artifactKind", "componentId"] }, "else": { "not": { "anyOf": [{ "required": ["artifactKind"] }, { "required": ["componentId"] }] } } }
      ]
    }
  }
}
