{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acedward/midnight-binary-forge/schema/build-set-v1.schema.json",
  "title": "Midnight binary forge build set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "buildSetId",
    "sourceFullSha",
    "destination",
    "components",
    "inputArtifacts",
    "existingCoverage",
    "payloads",
    "payloadCount",
    "coveragePolicy",
    "candidatePolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "build-set-v1" },
    "buildSetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "sourceFullSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "distributionTier", "releaseMutability"],
      "properties": {
        "repository": { "const": "effectstream/binaries" },
        "tag": { "const": "0.3.120" },
        "distributionTier": { "const": "development-only" },
        "releaseMutability": { "const": "mutable-warehouse" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "manifestPath", "manifestSha256"],
        "properties": {
          "componentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
          "manifestPath": { "type": "string", "pattern": "^catalog/components/[A-Za-z0-9._/-]+\\.json$" },
          "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "inputArtifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/inputArtifact" }
    },
    "existingCoverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverage" }
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/payload" }
    },
    "payloadCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "coveragePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "desired", "optional", "proofDataPlatform"],
      "properties": {
        "required": { "const": ["linux/amd64", "macos/arm64"] },
        "desired": { "const": ["linux/arm64"] },
        "optional": { "const": ["macos/amd64"] },
        "proofDataPlatform": { "const": "noarch" }
      }
    },
    "candidatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutableReleaseRequired",
        "protectedDefaultBranchRequired",
        "typedAssetListRequired",
        "sourceManifestTemplate",
        "checksumsTemplate",
        "inputArtifactPinningRequired",
        "destinationCredentialAllowed"
      ],
      "properties": {
        "immutableReleaseRequired": { "const": true },
        "protectedDefaultBranchRequired": { "const": true },
        "typedAssetListRequired": { "const": true },
        "sourceManifestTemplate": { "const": "source-manifest-<buildSetId>.json" },
        "checksumsTemplate": { "const": "sha256sums-<buildSetId>.txt" },
        "inputArtifactPinningRequired": { "const": true },
        "destinationCredentialAllowed": { "const": false }
      }
    }
  },
  "$defs": {
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "repository",
        "repositoryId",
        "workflowPath",
        "runId",
        "runAttempt",
        "runEvent",
        "runConclusion",
        "sourceRef",
        "sourceHeadSha",
        "artifactId",
        "artifactName",
        "artifactSize",
        "archiveSha256",
        "expiresAt"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "repository": { "const": "acedward/midnight-binary-forge" },
        "repositoryId": { "const": 1349127482 },
        "workflowPath": {
          "enum": [
            ".github/workflows/proof-data-q8b.yml",
            ".github/workflows/phase4-payloads.yml",
            ".github/workflows/phase5-indexer.yml"
          ]
        },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "const": 1 },
        "runEvent": { "enum": ["pull_request", "push", "workflow_dispatch"] },
        "runConclusion": { "const": "success" },
        "sourceRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "sourceHeadSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
        "artifactSize": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "version",
        "os",
        "arch",
        "tier",
        "source",
        "repository",
        "repositoryId",
        "repositoryNodeId",
        "releaseTag",
        "releaseId",
        "releaseNodeId",
        "snapshotPath",
        "snapshotSha256",
        "assetId",
        "assetNodeId",
        "name",
        "size",
        "sha256"
      ],
      "properties": {
        "family": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "version": { "type": "string", "minLength": 1 },
        "os": { "enum": ["linux", "macos"] },
        "arch": { "enum": ["amd64", "arm64"] },
        "tier": { "enum": ["required", "desired", "optional"] },
        "source": { "const": "warehouse-existing" },
        "repository": { "const": "effectstream/binaries" },
        "repositoryId": { "const": 1117580582 },
        "repositoryNodeId": { "const": "R_kgDOQpztJg" },
        "releaseTag": { "const": "0.3.120" },
        "releaseId": { "const": 270761136 },
        "releaseNodeId": { "const": "RE_kwDOQpztJs4QI3yw" },
        "snapshotPath": { "const": "evidence/phase0/warehouse-release-0.3.120.json" },
        "snapshotSha256": { "const": "6cb1abbbcf3e693e85b1d6806569caec956d5627b4aeb18ba413b519216124e1" },
        "assetId": { "type": "integer", "minimum": 1 },
        "assetNodeId": { "type": "string", "pattern": "^RA_[A-Za-z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "artifactKind",
        "componentId",
        "tier",
        "container",
        "size",
        "sha256",
        "sourceArtifactKey",
        "sourcePath",
        "installMode"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "role": { "const": "payload" },
        "artifactKind": { "enum": ["software", "proof-data"] },
        "componentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "tier": { "enum": ["required", "desired", "optional", "noarch"] },
        "container": { "enum": ["raw", "zip", "tar.gz"] },
        "size": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceArtifactKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "sourcePath": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$" },
        "installMode": { "enum": ["0644", "0755"] },
        "os": { "enum": ["linux", "macos"] },
        "arch": { "enum": ["amd64", "arm64"] },
        "platform": { "const": "noarch" },
        "k": { "type": "integer", "minimum": 0, "maximum": 19 },
        "ledgerStaticSemver": { "const": "9.0.0" }
      },
      "allOf": [
        {
          "if": { "properties": { "artifactKind": { "const": "software" } }, "required": ["artifactKind"] },
          "then": { "required": ["os", "arch"], "not": { "anyOf": [{ "required": ["platform"] }, { "required": ["k"] }, { "required": ["ledgerStaticSemver"] }] } }
        },
        {
          "if": { "properties": { "artifactKind": { "const": "proof-data" } }, "required": ["artifactKind"] },
          "then": { "required": ["platform"], "properties": { "tier": { "const": "noarch" } }, "not": { "anyOf": [{ "required": ["os"] }, { "required": ["arch"] }] } }
        },
        {
          "if": { "properties": { "name": { "pattern": "^bls_midnight_2p" } }, "required": ["name"] },
          "then": { "required": ["k"] }
        },
        {
          "if": { "properties": { "name": { "const": "midnight-ledger-static-noarch-9.0.0.zip" } }, "required": ["name"] },
          "then": { "required": ["ledgerStaticSemver"] }
        },
        {
          "if": { "properties": { "name": { "pattern": "(^|[-_.])compactc?([-_.]|$)" } }, "required": ["name"] },
          "then": false
        }
      ]
    }
  }
}
